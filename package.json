{
  "name": "md-viewer",
  "version": "1.4.1",
  "description": "ローカルMarkdownビューアー(単一ファイル/フォルダツリー対応、remark/rehypeプラグインで拡張可能)",
  "type": "module",
  "private": true,
  "bin": {
    "mdv": "bin/mdv.js"
  },
  "scripts": {
    "start": "node bin/mdv.js",
    "sample": "node bin/mdv.js sample --port 8931"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@shikijs/rehype": "^3.0.0",
    "chokidar": "^4.0.1",
    "d3": "^7.9.0",
    "express": "^5.1.0",
    "katex": "^0.16.11",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-emoji": "^4.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "shiki": "^3.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  }
}
